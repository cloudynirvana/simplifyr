# Lives at /etc/pumpbot/env on the server (owner root, group docker, mode 640). Never commit real values.
# Do NOT paste real values into chat or commit them. Rotate anything that has ever been pasted anywhere.
HELIUS_API_KEY=
SOLANA_RPC_URL=
# Telegram: status alerts only (up/down). No trading commands exist.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# PumpPortal data key: REQUIRED for the per-token trade stream (verified live: keyless gets only new-token events).
# Create a FRESH key; its wallet needs >= 0.02 SOL to unlock the stream. That wallet is controlled by PumpPortal's
# Lightning service, so keep it at the minimum and never use it for anything else. Do not reuse any key pasted in chat.
# PUMPPORTAL_API_KEY=
